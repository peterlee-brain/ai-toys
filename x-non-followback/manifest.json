{
  "manifest_version": 3,
  "name": "X 未回关按钮高亮",
  "version": "0.2.5",
  "description": "只读扫描已加载的 X Following 卡片，点亮未回关按钮，并在 Following 按钮左侧逐个标记序号。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "src/core.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
